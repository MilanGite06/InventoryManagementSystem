@model InventoryManagement.Web.Models.Product

@{
    ViewData["Title"] = "Add Product";
}

<h2>Add New Product</h2>

<form method="post" asp-action="Create">
    <div>
        <label>Product Name</label>
        <input type="text" name="ProductName" required />
    </div>
    <div>
        <label>Price</label>
        <input type="number" step="0.01" name="Price" required />
    </div>
    <div>
        <label>Category</label>
        <select name="CategoryId">
            @foreach (var cat in (List<InventoryManagement.Web.Models.Category>)ViewBag.Categories)
            {
                <option value="@cat.CategoryId">@cat.CategoryName</option>
            }
        </select>
    </div>
    <div>
        <label>Supplier</label>
        <select name="SupplierId">
            @foreach (var sup in (List<InventoryManagement.Web.Models.Supplier>)ViewBag.Suppliers)
            {
                <option value="@sup.SupplierId">@sup.SupplierName</option>
            }
        </select>
    </div>
    <button type="submit">Add Product</button>
</form>

<a asp-action="Index">Back to List</a>