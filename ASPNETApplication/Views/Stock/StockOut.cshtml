@{
    ViewData["Title"] = "Stock Out";
}

<h2>Stock Out</h2>

@if (ViewBag.Error != null)
{
    <div style="color:red">@ViewBag.Error</div>
}

<form method="post" asp-action="StockOut">
    <div>
        <label>Product</label>
        <select name="productId">
            @foreach (var s in (List<InventoryManagement.Web.Models.Stock>)ViewBag.Stocks)
            {
                <option value="@s.ProductId">@s.Product.ProductName (Available: @s.QuantityAvailable)</option>
            }
        </select>
    </div>
    <div>
        <label>Quantity to Remove</label>
        <input type="number" name="quantity" required />
    </div>
    <div>
        <label>Performed By (Staff Name)</label>
        <input type="text" name="performedBy" required />
    </div>
    <button type="submit">Stock Out</button>
</form>

<p><a asp-action="Index">Back to Stock Overview</a></p>