@model List<InventoryManagement.Web.Models.StockTransaction>

@{
    ViewData["Title"] = "Transaction History";
}

<h2>Transaction History</h2>

<table>
    <tr>
        <th>Date</th>
        <th>Product</th>
        <th>Type</th>
        <th>Quantity</th>
        <th>Performed By</th>
    </tr>
    @foreach (var t in Model)
    {
        <tr>
            <td>@t.TransactionDate.ToString("g")</td>
            <td>@t.Product?.ProductName</td>
            <td>@t.Type</td>
            <td>@t.Quantity</td>
            <td>@t.PerformedBy</td>
        </tr>
    }
</table>

<p><a asp-action="Index">Back to Stock Overview</a></p>